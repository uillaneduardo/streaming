# Copie para .env e configure senhas únicas antes de subir
WEB_PORT=8088
DB_NAME=cenalivre
DB_USER=cenalivre
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_OTHER_LONG_RANDOM_PASSWORD

# true quando acessado por HTTPS via Cloudflare Tunnel (obrigatório para produção)
COOKIE_SECURE=false
